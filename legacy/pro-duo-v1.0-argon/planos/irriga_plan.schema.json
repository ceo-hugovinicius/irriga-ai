{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://irriga.ai/schemas/irriga_plan_v1.schema.json",
  "title": "IrrigaPlan v1.0 — Schema Oficial do Sistema Irriga.ai Pro-Duo",
  "description": "Validador automático para planos de irrigação gerados manualmente ou via IA (Claude/LLMs).",
  "type": "object",
  "required": [
    "versao_padrao",
    "sistema",
    "cotas_e_seguranca",
    "inteligencia_climatica",
    "botoes_fisicos_painel",
    "zonas_de_plantio",
    "arquitetura_8_reles_e_expansao"
  ],
  "properties": {
    "versao_padrao": { "type": "string", "const": "1.0" },
    "sistema": { "type": "string" },
    "ultima_atualizacao": { "type": "string" },
    "autor_ultima_edicao": { "type": "string" },
    "localizacao_sitio": {
      "type": "object",
      "required": ["latitude", "longitude", "fuso_horario"],
      "properties": {
        "nome": { "type": "string" },
        "latitude": { "type": "number", "minimum": -90, "maximum": 90 },
        "longitude": { "type": "number", "minimum": -180, "maximum": 180 },
        "fuso_horario": { "type": "string" },
        "provedor_clima": { "type": "string", "enum": ["open-meteo"] }
      }
    },
    "cotas_e_seguranca": {
      "type": "object",
      "required": [
        "capacidade_caixa_litros",
        "cota_diaria_maxima_litros",
        "nivel_minimo_seguranca_caixa_pct",
        "tempo_maximo_valvula_aberta_min"
      ],
      "properties": {
        "capacidade_caixa_litros": { "type": "number", "minimum": 100, "maximum": 50000 },
        "cota_diaria_maxima_litros": { "type": "number", "minimum": 10, "maximum": 5000 },
        "cota_semanal_maxima_litros": { "type": "number", "minimum": 50, "maximum": 35000 },
        "nivel_minimo_seguranca_caixa_pct": { "type": "integer", "enum": [25, 50, 75] },
        "modo_rateio_quando_atingir_cota": {
          "type": "string",
          "enum": ["PRIORIZAR_FASE_CRITICA", "PROPORCIONAL_IGUAL"]
        },
        "tempo_maximo_valvula_aberta_min": { "type": "integer", "minimum": 5, "maximum": 240 },
        "filtro_unico_120_mesh": {
          "type": "object",
          "properties": {
            "alerta_limpeza_abaixo_de_pct": { "type": "number", "minimum": 50, "maximum": 95 },
            "parada_emergencia_abaixo_de_pct": { "type": "number", "minimum": 20, "maximum": 70 }
          }
        }
      }
    },
    "inteligencia_climatica": {
      "type": "object",
      "properties": {
        "usar_evapotranspiracao_et0_real": { "type": "boolean" },
        "chuva": {
          "type": "object",
          "properties": {
            "descontar_chuva_ultimas_24h_pct": { "type": "number", "minimum": 0, "maximum": 100 },
            "adiar_rega_se_chance_chuva_maior_pct": { "type": "number", "minimum": 30, "maximum": 100 },
            "adiar_rega_se_chuva_prevista_maior_mm": { "type": "number", "minimum": 1, "maximum": 50 },
            "proteger_fase_critica_mesmo_com_previsao": { "type": "boolean" }
          }
        },
        "exposicao_ao_calor_diurno": {
          "type": "object",
          "properties": {
            "ativo": { "type": "boolean" },
            "temperatura_limite_estresse_c": { "type": "number", "minimum": 25, "maximum": 42 },
            "bonus_rega_tarde_por_hora_quente_pct": { "type": "number", "minimum": 0, "maximum": 15 },
            "teto_maximo_bonus_calor_pct": { "type": "number", "minimum": 0, "maximum": 50 }
          }
        },
        "exposicao_ao_vento": {
          "type": "object",
          "properties": {
            "ativo": { "type": "boolean" },
            "vento_forte_acima_kmh": { "type": "number", "minimum": 10, "maximum": 60 },
            "bonus_protecao_vento_pct": { "type": "number", "minimum": 0, "maximum": 30 }
          }
        }
      }
    },
    "botoes_fisicos_painel": {
      "type": "object",
      "required": [
        "botao_1_pausar",
        "botao_2_continuar",
        "botao_3_liga_tudo_mais_1h",
        "botao_4_era_bom_que_chovesse"
      ]
    },
    "zonas_de_plantio": {
      "type": "object",
      "required": ["zona_1", "zona_2"],
      "properties": {
        "zona_1": { "$ref": "#/$defs/zona_schema" },
        "zona_2": { "$ref": "#/$defs/zona_schema" }
      }
    },
    "arquitetura_8_reles_e_expansao": {
      "type": "object",
      "required": ["rele_1", "rele_2", "rele_3", "rele_4", "rele_5", "rele_6", "rele_7", "rele_8"]
    }
  },
  "$defs": {
    "zona_schema": {
      "type": "object",
      "required": [
        "id",
        "nome",
        "ativa",
        "canal_rele",
        "gpio_esp32",
        "area_total_m2",
        "cultura_atual",
        "modo_calculo",
        "turnos_diarios",
        "fases_fenologicas"
      ],
      "properties": {
        "id": { "type": "integer", "enum": [1, 2] },
        "nome": { "type": "string" },
        "ativa": { "type": "boolean" },
        "canal_rele": { "type": "integer", "enum": [2, 3] },
        "gpio_esp32": { "type": "integer", "enum": [16, 17] },
        "area_total_m2": { "type": "number", "minimum": 1, "maximum": 2000 },
        "mangueiras_16mm_totais": { "type": "integer", "minimum": 1, "maximum": 50 },
        "mangueiras_16mm_abertas_agora": { "type": "integer", "minimum": 1, "maximum": 50 },
        "vazao_nominal_referencia_lpm": { "type": "number", "minimum": 0.5, "maximum": 60 },
        "modo_calculo": {
          "type": "string",
          "enum": ["INTELIGENTE_POR_ESTAGIO", "MANUAL_DIRETO"]
        },
        "ajuste_fino_usuario_pct": { "type": "number", "minimum": -50, "maximum": 50 },
        "cultura_atual": {
          "type": "object",
          "required": ["id_catalogo", "nome_exibicao", "familia_botanica", "data_plantio", "ciclo_previsto_dias"],
          "properties": {
            "id_catalogo": { "type": "string" },
            "nome_exibicao": { "type": "string" },
            "familia_botanica": { "type": "string" },
            "data_plantio": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
            "ciclo_previsto_dias": { "type": "integer", "minimum": 20, "maximum": 600 },
            "cultura_anterior_na_zona": { "type": "string" },
            "proxima_sugerida_rotacao": { "type": "string" }
          }
        },
        "turnos_diarios": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "items": {
            "type": "object",
            "required": ["horario_inicio", "proporcao_do_dia_pct"],
            "properties": {
              "horario_inicio": { "type": "string", "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$" },
              "proporcao_do_dia_pct": { "type": "number", "minimum": 5, "maximum": 100 },
              "litros_fixos_manual": { "type": "number", "minimum": 1, "maximum": 2000 }
            }
          }
        },
        "fases_fenologicas": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["fase", "nome", "dia_inicio", "dia_fim", "fator_kc", "lamina_base_mm_dia", "prioridade_cota", "mensagem_humana"],
            "properties": {
              "fase": { "type": "integer" },
              "nome": { "type": "string" },
              "dia_inicio": { "type": "integer", "minimum": 1 },
              "dia_fim": { "type": "integer", "minimum": 1 },
              "fator_kc": { "type": "number", "minimum": 0.1, "maximum": 1.5 },
              "lamina_base_mm_dia": { "type": "number", "minimum": 0.5, "maximum": 12.0 },
              "prioridade_cota": { "type": "string", "enum": ["BAIXA", "MEDIA", "ALTA", "MAXIMA_CRITICA"] },
              "mensagem_humana": { "type": "string" }
            }
          }
        }
      }
    }
  }
}
